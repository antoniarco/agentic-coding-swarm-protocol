{
  "protocol": "swarm",
  "version": "0.4.0",
  "level": 0,
  "integrationBranch": "main",
  "commands": {
    "setup": "corepack enable && pnpm install --frozen-lockfile",
    "verify": "pnpm verify",
    "verifyQuick": "pnpm verify --quick",
    "commit": "pnpm wt:commit",
    "status": "pnpm wt:status",
    "land": "pnpm land",
    "newAdr": "docs/adr/draft-<slug>.md",
    "audit": "pnpm audit:repo",
    "ratchets": "node scripts/dev/ratchets.ts",
    "findings": "node scripts/dev/findings.ts",
    "leases": "node scripts/dev/leases.ts",
    "overlap": "node scripts/dev/overlap.ts"
  },
  "hooks": {
    "sessionStart": "node scripts/dev/wt.ts setup; node scripts/dev/leases.ts session; node scripts/dev/overlap.ts --session",
    "stop": "node scripts/dev/wt.ts wip; node scripts/dev/leases.ts renew --hook",
    "preEdit": "node scripts/dev/leases.ts check",
    "postEdit": "node scripts/dev/overlap.ts --notify",
    "gateEdit": "warn"
  },
  "leases": {
    "ttlMinutes": 30,
    "exclusive": [
      "**/migrations/**",
      "*.sql",
      "src/shared/types/**",
      "src/**/contracts/**"
    ]
  },
  "findings": {
    "file": "docs/audits/findings.jsonl",
    "sla": {
      "high": 2,
      "medium": 14,
      "low": 60
    },
    "closureEvery": 3
  },
  "roadmap": {
    "maxActive": 12,
    "staleDays": 14
  },
  "gates": [],
  "review": {
    "mode": "sensitive",
    "sensitive": [
      "**/auth/**",
      "**/*auth*.*",
      "**/session*/**",
      "**/payments/**",
      "**/billing/**",
      "**/migrations/**",
      "*.sql",
      ".github/**",
      ".githooks/**",
      ".claude/**",
      "swarm.json",
      "scripts/dev/**",
      "**/vitest.config.*",
      "**/architecture.test.*",
      "**/docs.test.*",
      "biome.json",
      "quality-ratchets.json",
      "pnpm-lock.yaml"
    ],
    "pr": {
      "botTimeoutHours": 2,
      "requireReviewer": true,
      "bots": []
    }
  }
}
